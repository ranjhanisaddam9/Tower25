<?xml version="1.0" encoding="utf-8"?>
<!--
  Server deployment (M10): framework-dependent win-x64 Release build for IIS in-process hosting.
  The server needs the ASP.NET Core 10 Hosting Bundle. Used by build-package.ps1:
    dotnet publish src/HR.Web -p:PublishProfile=IIS-win-x64
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <EnvironmentName>Production</EnvironmentName>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <PublishUrl>bin\publish\iis-win-x64\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
