@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "Overview";

    var current = Model.CurrentPeriod;
    var next = Model.NextPeriod;
    var people = Model.People;
    var tiles = new[]
    {
        new StatTileViewModel("Active people", people.Active.ToString("N0", System.Globalization.CultureInfo.InvariantCulture), "bi-people", "indigo",
            $"{people.Employees} {(people.Employees == 1 ? "employee" : "employees")} · {people.Internees} {(people.Internees == 1 ? "internee" : "internees")}",
            Href: "/people", TestId: "active-people-tile"),
        Model.Rate.UsdToPkr is { } usdToPkr
            ? new StatTileViewModel("USD/PKR rate", "Rs " + HR.Domain.Rates.ExchangeRateRules.Format(usdToPkr), "bi-currency-exchange", "teal",
                $"since {DisplayFormat.Date(Model.Rate.Since!.Value)}",
                Model.Rate.Change is { } rateChange ? rateChange.Text + " vs previous" : null, "neutral",
                Href: "/exchange-rates", TestId: "rate-tile")
            : new StatTileViewModel("USD/PKR rate", "Not set", "bi-currency-exchange", "teal", "Add rate",
                Href: "/exchange-rates/create", TestId: "rate-tile"),
        new StatTileViewModel("Absences this period", $"{AbsenceDisplay.Days(Model.Absences.PeriodDays)} {(Model.Absences.PeriodDays == 1m ? "day" : "days")}", "bi-calendar-x", "warning",
            $"{AbsenceDisplay.Days(Model.Absences.PeriodUnpaidDays)} unpaid", Href: "/absences", TestId: "absences-tile"),
        new StatTileViewModel("Absent today", Model.Absences.AbsentToday.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-person-dash", "info",
            !HR.Domain.Payroll.WorkingDays.IsWorkingDay(Model.Today) ? "Not a working day" : Model.Absences.AbsentToday == 0 ? "Everyone is in" : "Take attendance",
            Href: "/absences/day", TestId: "absent-today-tile"),
    };
}

@if (Model.Alerts is { Any: true } alerts)
{
    <div class="glass-alert alert-danger-glass security-alert" role="alert" data-testid="security-alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        <div>
            <p class="mb-1"><strong>Security activity in the last 24 hours</strong></p>
            <ul class="mb-1">
                @if (alerts.FailedLogins >= HR.Infrastructure.Security.SecurityAlerts.FailedLoginThreshold)
                {
                    <li>@alerts.FailedLogins failed sign-ins</li>
                }
                @if (alerts.Lockouts > 0)
                {
                    <li>@alerts.Lockouts @(alerts.Lockouts == 1 ? "account lockout" : "account lockouts")</li>
                }
                @if (alerts.TwoFactorFailures >= HR.Infrastructure.Security.SecurityAlerts.TwoFactorFailureThreshold)
                {
                    <li>@alerts.TwoFactorFailures rejected two-factor codes</li>
                }
                @if (alerts.PayrollReopens > 0)
                {
                    <li>@alerts.PayrollReopens @(alerts.PayrollReopens == 1 ? "payroll reopened" : "payrolls reopened")</li>
                }
            </ul>
            <a asp-controller="Audit" asp-action="Index" asp-route-from="@Model.Today.AddDays(-1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">Review the audit log</a>
        </div>
    </div>
}

@if (Model.Backup is { } backup)
{
    <div class="glass-alert alert-warning-glass security-alert" role="alert" data-testid="backup-alert">
        <i class="bi bi-database-exclamation" aria-hidden="true"></i>
        <div>
            <p class="mb-1"><strong>@(backup.Problem switch
            {
                HR.Infrastructure.Backups.BackupProblem.NeverRun => "No backup has run yet",
                HR.Infrastructure.Backups.BackupProblem.LastRunFailed => "The last backup failed",
                HR.Infrastructure.Backups.BackupProblem.Unreadable => "The backup status can't be read",
                _ => "The last good backup is more than 48 hours old",
            })</strong></p>
            <p class="mb-1">
                @if (backup.LastGoodUtc is { } good)
                {
                    <text>Last good backup: @DisplayFormat.DateTime(good).</text>
                }
                else
                {
                    <text>There is no good backup on record.</text>
                }
                @if (!string.IsNullOrEmpty(backup.Message))
                {
                    <span class="d-block">@backup.Message</span>
                }
            </p>
            <p class="mb-0">Run <code>backup.ps1</code> on the server as Administrator and check <code>C:\HRPayroll\backups\backup.log</code> (see INSTALL.md).</p>
        </div>
    </div>
}

<p class="page-lead">Today is <time datetime="@Model.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@DisplayFormat.Date(Model.Today)</time> (Asia/Karachi).</p>

<section class="stat-grid" aria-label="Key figures">
    <partial name="_StatTile" model="tiles[0]" />
    <partial name="_StatTile" model="tiles[1]" />

    <div class="stat-tile glass-card stat-tile-period">
        <span class="stat-icon tone-violet" aria-hidden="true"><i class="bi bi-calendar-range"></i></span>
        <div class="stat-body">
            <p class="stat-label">Current pay period</p>
            <p class="stat-value" data-testid="current-period">@DisplayFormat.DateRange(current.Start, current.End)</p>
            <p class="stat-caption">@current.WorkingDays working days</p>
            <p class="stat-next">
                <span class="stat-next-label">Next:</span>
                <span data-testid="next-period">@DisplayFormat.DateRange(next.Start, next.End)</span>
                <span class="stat-next-days">· @next.WorkingDays working days</span>
            </p>
        </div>
    </div>

    <partial name="_StatTile" model="tiles[2]" />
    <partial name="_StatTile" model="tiles[3]" />

    @{
        var payrollTile = Model.Payroll;
        var payrollStatus = payrollTile.Status switch
        {
            null => "Not started",
            HR.Domain.Payroll.PayrollStatus.Draft => "Draft",
            _ => "Finalized",
        };
    }
    <partial name="_StatTile" model="@(new StatTileViewModel($"Payroll {DisplayFormat.DateRange(payrollTile.Period.Start, payrollTile.Period.End)}", payrollStatus, "bi-receipt", "violet",
        payrollTile.RunId is null ? "Generate the draft" : "Open the payroll", Href: payrollTile.RunId is { } runId ? $"/payroll/{runId}" : "/payroll", TestId: "payroll-tile"))" />

    @if (Model.Invoices is { } outstanding)
    {
        <partial name="_StatTile" model="@(new StatTileViewModel("Outstanding invoices", DisplayFormat.Usd(outstanding.OutstandingUsd), "bi-file-earmark-text", outstanding.OverdueCount > 0 ? "danger" : "info",
            (outstanding.OutstandingCount == 0 && outstanding.ShortPaidCount == 0 ? "Nothing to collect" : $"{outstanding.OutstandingCount} unpaid · {outstanding.OverdueCount} overdue")
                + (outstanding.ShortPaidCount > 0 ? $" · {outstanding.ShortPaidCount} paid short" : "")
                + (outstanding.ReceivedInExcessUsd > 0m ? $" · received in excess {DisplayFormat.Usd(outstanding.ReceivedInExcessUsd)}" : ""),
            Href: outstanding.OverdueCount > 0 ? "/invoices?status=Overdue" : "/invoices?status=Issued", TestId: "invoices-tile"))" />
    }

    @if (Model.PayrollAdmin is { } latest)
    {
        <partial name="_StatTile" model="@(new StatTileViewModel("Latest finalized payroll", DisplayFormat.Usd(latest.InvoiceUsd) + " invoiced", "bi-graph-up-arrow", "teal",
            $"{DisplayFormat.Usd(latest.OwnerEarningUsd)} your earning · {DisplayFormat.DateRange(latest.Period.Start, latest.Period.End)}", Href: $"/payroll/{latest.RunId}", TestId: "payroll-admin-tile"))" />
    }

    <partial name="_StatTile" model="@(new StatTileViewModel("No pay setup", Model.NoPaySetup.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-cash-stack", "violet", Model.NoPaySetup == 0 ? "Everyone active has pay set up" : "Active people without pay", Href: "/salaries?filter=MissingSetup", TestId: "no-pay-tile"))" />

    @if (Model.PendingBillingReviews is { } reviews)
    {
        <partial name="_StatTile" model="@(new StatTileViewModel("Billing reviews pending", reviews.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-clipboard-check", "warning", reviews == 0 ? "Nothing to review" : "Pay changed by a Manager", Href: "/salaries?filter=NeedsReview", TestId: "review-tile"))" />
    }

    @if (Model.HireSourceNotAssigned is { } notAssigned)
    {
        <partial name="_StatTile" model="@(new StatTileViewModel("Hire source not assigned", notAssigned.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-question-diamond", "warning", notAssigned == 0 ? "Every active person has a source" : "Active people to review", Href: "/people?hireSource=NotAssigned", TestId: "hire-source-tile"))" />
    }
</section>

<section class="glass-card trend-card" aria-labelledby="trendTitle" data-testid="trend-card">
    <div class="trend-head">
        <h2 class="card-title" id="trendTitle">Payroll trend</h2>
        <a class="btn btn-ghost" asp-controller="Reports" asp-action="PayrollHistory">Payroll history <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </div>
    <p class="trend-summary" data-testid="trend-summary">@Model.Trend.Summary</p>
    @if (Model.Trend.OldestFirst.Count > 1)
    {
        <div class="trend-lines">
            <figure class="trend-figure">
                <svg class="sparkline" viewBox="0 0 @SparklineViewModel.Width @SparklineViewModel.Height" aria-hidden="true" focusable="false" data-testid="sparkline-netpay">
                    <polyline class="@Model.Trend.NetPay.Css" points="@Model.Trend.NetPay.Points" />
                </svg>
                <figcaption><span class="legend-swatch chart-salary" aria-hidden="true"></span> Net pay (PKR), last @Model.Trend.OldestFirst.Count finalized periods</figcaption>
            </figure>
            @if (Model.Trend.Earning is { } earning)
            {
                <figure class="trend-figure">
                    <svg class="sparkline" viewBox="0 0 @SparklineViewModel.Width @SparklineViewModel.Height" aria-hidden="true" focusable="false" data-testid="sparkline-earning">
                        <polyline class="@earning.Css" points="@earning.Points" />
                    </svg>
                    <figcaption><span class="legend-swatch chart-commission" aria-hidden="true"></span> Owner earning (USD)</figcaption>
                </figure>
            }
        </div>
    }
</section>

<section class="glass-card dashboard-welcome" aria-labelledby="welcomeTitle">
    <h2 class="card-title" id="welcomeTitle">Welcome to HR Payroll</h2>
    <p class="text-muted-glass mb-0">
        Pay periods run from the 1st to the 15th and from the 16th to month-end. Working days are Monday to Friday.
        The sections in the sidebar are switched on milestone by milestone.
    </p>
</section>
