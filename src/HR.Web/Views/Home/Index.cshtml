@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "Overview";

    var current = Model.CurrentPeriod;
    var next = Model.NextPeriod;
    var people = Model.People;
    var tiles = new[]
    {
        new StatTileViewModel("Active people", people.Active.ToString("N0", System.Globalization.CultureInfo.InvariantCulture), "bi-people", "indigo",
            $"{people.Employees} {(people.Employees == 1 ? "employee" : "employees")} · {people.Internees} {(people.Internees == 1 ? "internee" : "internees")}",
            Href: "/people", TestId: "active-people-tile"),
        Model.Rate.UsdToPkr is { } usdToPkr
            ? new StatTileViewModel("USD/PKR rate", "Rs " + HR.Domain.Rates.ExchangeRateRules.Format(usdToPkr), "bi-currency-exchange", "teal",
                $"since {DisplayFormat.Date(Model.Rate.Since!.Value)}",
                Model.Rate.Change is { } rateChange ? rateChange.Text + " vs previous" : null, "neutral",
                Href: "/exchange-rates", TestId: "rate-tile")
            : new StatTileViewModel("USD/PKR rate", "Not set", "bi-currency-exchange", "teal", "Add rate",
                Href: "/exchange-rates/create", TestId: "rate-tile"),
        new StatTileViewModel("Absences this period", $"{AbsenceDisplay.Days(Model.Absences.PeriodDays)} {(Model.Absences.PeriodDays == 1m ? "day" : "days")}", "bi-calendar-x", "warning",
            $"{AbsenceDisplay.Days(Model.Absences.PeriodUnpaidDays)} unpaid", Href: "/absences", TestId: "absences-tile"),
        new StatTileViewModel("Absent today", Model.Absences.AbsentToday.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-person-dash", "info",
            !HR.Domain.Payroll.WorkingDays.IsWorkingDay(Model.Today) ? "Not a working day" : Model.Absences.AbsentToday == 0 ? "Everyone is in" : "Take attendance",
            Href: "/absences/day", TestId: "absent-today-tile"),
    };
}

<p class="page-lead">Today is <time datetime="@Model.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@DisplayFormat.Date(Model.Today)</time> (Asia/Karachi).</p>

<section class="stat-grid" aria-label="Key figures">
    <partial name="_StatTile" model="tiles[0]" />
    <partial name="_StatTile" model="tiles[1]" />

    <div class="stat-tile glass-card stat-tile-period">
        <span class="stat-icon tone-violet" aria-hidden="true"><i class="bi bi-calendar-range"></i></span>
        <div class="stat-body">
            <p class="stat-label">Current pay period</p>
            <p class="stat-value" data-testid="current-period">@DisplayFormat.DateRange(current.Start, current.End)</p>
            <p class="stat-caption">@current.WorkingDays working days</p>
            <p class="stat-next">
                <span class="stat-next-label">Next:</span>
                <span data-testid="next-period">@DisplayFormat.DateRange(next.Start, next.End)</span>
                <span class="stat-next-days">· @next.WorkingDays working days</span>
            </p>
        </div>
    </div>

    <partial name="_StatTile" model="tiles[2]" />
    <partial name="_StatTile" model="tiles[3]" />

    <partial name="_StatTile" model="@(new StatTileViewModel("No pay setup", Model.NoPaySetup.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-cash-stack", "violet", Model.NoPaySetup == 0 ? "Everyone active has pay set up" : "Active people without pay", Href: "/salaries?filter=MissingSetup", TestId: "no-pay-tile"))" />

    @if (Model.PendingBillingReviews is { } reviews)
    {
        <partial name="_StatTile" model="@(new StatTileViewModel("Billing reviews pending", reviews.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-clipboard-check", "warning", reviews == 0 ? "Nothing to review" : "Pay changed by a Manager", Href: "/salaries?filter=NeedsReview", TestId: "review-tile"))" />
    }

    @if (Model.HireSourceNotAssigned is { } notAssigned)
    {
        <partial name="_StatTile" model="@(new StatTileViewModel("Hire source not assigned", notAssigned.ToString(System.Globalization.CultureInfo.InvariantCulture), "bi-question-diamond", "warning", notAssigned == 0 ? "Every active person has a source" : "Active people to review", Href: "/people?hireSource=NotAssigned", TestId: "hire-source-tile"))" />
    }
</section>

<section class="glass-card dashboard-welcome" aria-labelledby="welcomeTitle">
    <h2 class="card-title" id="welcomeTitle">Welcome to HR Payroll</h2>
    <p class="text-muted-glass mb-0">
        Pay periods run from the 1st to the 15th and from the 16th to month-end. Working days are Monday to Friday.
        The sections in the sidebar are switched on milestone by milestone.
    </p>
</section>
