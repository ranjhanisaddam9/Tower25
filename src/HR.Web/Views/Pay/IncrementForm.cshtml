@model IncrementFormPage
@{
    var isEdit = Model.RecordId is not null;
    ViewData["Title"] = isEdit ? "Edit pay change" : "Record increment";
    ViewData["Section"] = "People";
    var form = Model.Form;
    var pickerData = new ViewDataDictionary(ViewData) { ["Earliest"] = Model.EarliestEffectiveFrom };
}

<section class="glass-card form-card" aria-labelledby="incrementHeading">
    <h2 class="card-title" id="incrementHeading">@Model.PersonName <span class="text-muted-glass num">· @Model.PersonCode</span></h2>
    @if (Model.Current is { } current)
    {
        <p class="text-muted-glass" data-testid="increment-current">Current salary: <strong class="num">@DisplayFormat.Usd(current.SalaryMonthlyUsd)</strong> a month, since @DisplayFormat.Date(current.EffectiveFrom).</p>
    }

    <div asp-validation-summary="ModelOnly" class="glass-alert alert-danger-glass validation-summary-plain" role="alert" data-testid="increment-errors"></div>

    <form method="post" asp-action="@(isEdit ? "EditIncrement" : "Increment")" asp-route-personId="@Model.PersonId" asp-route-recordId="@Model.RecordId">
        @if (isEdit)
        {
            <input type="hidden" name="RowVersion" value="@form.RowVersion" />
        }

        <partial name="_PeriodPicker" model="form" view-data="pickerData" />

        <fieldset class="form-section">
            <legend class="form-section-title">New salary</legend>
            <div class="form-floating">
                <input asp-for="Form.Salary" name="Salary" id="Salary" class="form-control num" type="number" step="0.01" min="1"
                       placeholder="Salary" aria-describedby="Salary-error Salary-help" />
                <label for="Salary">New monthly salary (USD)</label>
            </div>
            <span class="field-error" id="Salary-error">@ViewData.ModelState["Salary"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
            <span class="field-help" id="Salary-help">@(Model.UsdToPkr is { } r ? $"Paid in PKR at each payroll's exchange rate (today Rs {HR.Domain.Rates.ExchangeRateRules.Format(r)} per USD)." : "Paid in PKR at each payroll's exchange rate.")</span>
            <div class="form-floating mt-3">
                <input asp-for="Form.Note" name="Note" id="Note" class="form-control" maxlength="300" placeholder="Note" />
                <label for="Note">Note (optional)</label>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary-gradient"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> @(isEdit ? "Save changes" : "Record increment")</button>
            <a class="btn btn-ghost" asp-controller="People" asp-action="Details" asp-route-id="@Model.PersonId" asp-fragment="pay">Cancel</a>
        </div>
    </form>
</section>

@if (isEdit)
{
    <section class="glass-card form-card mt-4" aria-labelledby="deleteIncrementHeading">
        <h2 class="card-title" id="deleteIncrementHeading">Delete</h2>
        <form method="post" asp-action="Delete" asp-route-personId="@Model.PersonId" asp-route-recordId="@Model.RecordId">
            <button type="submit" class="btn btn-danger-solid"
                    data-confirm="This pay change will be removed."
                    data-confirm-title="Delete this pay change?"
                    data-confirm-action="Delete">
                <i class="bi bi-trash" aria-hidden="true"></i> Delete pay change
            </button>
        </form>
    </section>
}
