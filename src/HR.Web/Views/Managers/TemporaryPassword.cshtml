@model TemporaryPasswordViewModel
@{
    ViewData["Title"] = Model.IsReset ? "Password reset" : "Manager created";
    ViewData["Section"] = "Managers";
}

<section class="glass-card form-card" aria-labelledby="tempHeading">
    <div class="card-heading-row">
        <span class="stat-icon tone-success" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
        <h2 class="card-title mb-0" id="tempHeading">
            @(Model.IsReset ? $"New temporary password for {Model.FullName}" : $"{Model.FullName} can now sign in")
        </h2>
    </div>

    <dl class="detail-list">
        <dt>Sign-in email</dt>
        <dd>@Model.Email</dd>
        <dt>Temporary password</dt>
        <dd class="temp-password-row">
            <code class="temp-password" id="tempPassword" data-testid="temp-password">@Model.TemporaryPassword</code>
            <button type="button" class="btn btn-ghost" data-copy-target="tempPassword" aria-describedby="copyStatus">
                <i class="bi bi-clipboard" aria-hidden="true"></i> <span class="copy-label">Copy</span>
            </button>
            <span class="visually-hidden" id="copyStatus" aria-live="polite"></span>
        </dd>
    </dl>

    <div class="glass-alert alert-warning-glass" role="note">
        <i class="bi bi-eye-slash" aria-hidden="true"></i>
        <p class="mb-0"><strong>This password is shown only once.</strong> Copy it now and give it to @Model.FullName in person or over a secure channel. They must change it at their next sign-in.</p>
    </div>

    <div class="form-actions">
        <a class="btn btn-primary-gradient" asp-action="Index">Done</a>
    </div>
</section>
