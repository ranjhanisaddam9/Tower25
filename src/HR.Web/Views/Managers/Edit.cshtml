@model ManagerEditViewModel
@{
    ViewData["Title"] = "Edit Manager";
    ViewData["Section"] = "Managers";
}

<section class="glass-card form-card" aria-labelledby="editHeading">
    <div class="card-heading-row">
        <h2 class="card-title mb-0" id="editHeading">Details</h2>
        @if (Model.IsActive)
        {
            <span class="pill pill-success">Active</span>
        }
        else
        {
            <span class="pill pill-danger">Inactive</span>
        }
    </div>
    <p class="text-muted-glass">Changing the email also changes the sign-in name and signs the Manager out.</p>

    <div asp-validation-summary="ModelOnly" class="glass-alert alert-danger-glass validation-summary-plain" role="alert"></div>

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" novalidate>
        <partial name="_ManagerFields" model="Model.Form" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary-gradient"><i class="bi bi-check2" aria-hidden="true"></i> Save changes</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

<section class="glass-card form-card mt-4" aria-labelledby="twoFactorHeading" data-testid="manager-two-factor">
    <h2 class="card-title" id="twoFactorHeading">Two-factor sign-in</h2>
    <dl class="detail-list">
        <dt>Status</dt>
        <dd>
            <span class="pill @(Model.TwoFactorEnabled ? "pill-success" : "pill-neutral")" data-testid="manager-2fa-status">@(Model.TwoFactorEnabled ? "On" : "Off")</span>
            <span class="pill @(Model.RequireTwoFactor ? "pill-info" : "pill-neutral")">@(Model.RequireTwoFactor ? "Required" : "Optional")</span>
        </dd>
    </dl>
    <div class="access-actions">
        <form method="post" asp-action="RequireTwoFactor" asp-route-id="@Model.Id">
            <input type="hidden" name="required" value="@(Model.RequireTwoFactor ? "false" : "true")" />
            <button type="submit" class="btn btn-ghost">
                <i class="bi @(Model.RequireTwoFactor ? "bi-shield" : "bi-shield-lock")" aria-hidden="true"></i>
                @(Model.RequireTwoFactor ? "Make optional" : "Require two-factor sign-in")
            </button>
        </form>
        @if (Model.TwoFactorEnabled)
        {
            <form method="post" asp-action="ResetTwoFactor" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-ghost"
                        data-confirm="Their authenticator and recovery codes stop working and they are signed out. If two-factor is required they set it up again at the next sign-in."
                        data-confirm-title="Reset two-factor sign-in?"
                        data-confirm-action="Reset">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset two-factor
                </button>
            </form>
        }
    </div>
</section>

<section class="glass-card form-card mt-4" aria-labelledby="accessHeading">
    <h2 class="card-title" id="accessHeading">Access</h2>
    <div class="access-actions">
        <form method="post" asp-action="ResetPassword" asp-route-id="@Model.Id">
            <button type="submit" class="btn btn-ghost"
                    data-confirm="A new temporary password will be generated and shown once. @Model.Form.FullName will be signed out and must change it at next sign-in."
                    data-confirm-title="Reset password?"
                    data-confirm-action="Reset password">
                <i class="bi bi-key" aria-hidden="true"></i> Reset password
            </button>
        </form>
        @if (Model.IsActive)
        {
            <form method="post" asp-action="Deactivate" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger-solid"
                        data-confirm="@Model.Form.FullName will be signed out and can't sign in until reactivated."
                        data-confirm-title="Deactivate this manager?"
                        data-confirm-action="Deactivate">
                    <i class="bi bi-person-dash" aria-hidden="true"></i> Deactivate
                </button>
            </form>
        }
        else
        {
            <form method="post" asp-action="Activate" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-ghost"
                        data-confirm="@Model.Form.FullName will be able to sign in again."
                        data-confirm-title="Activate this manager?"
                        data-confirm-action="Activate"
                        data-confirm-variant="primary">
                    <i class="bi bi-person-check" aria-hidden="true"></i> Activate
                </button>
            </form>
        }
    </div>
</section>
