@using HR.Domain.Payroll
@model PayrollIndexViewModel
@{
    ViewData["Title"] = "Payroll";
    ViewData["Section"] = "Payroll";
    var admin = Model.AdminTotals;
}

<div class="page-actions">
    <p class="page-lead mb-0">One payroll per pay period: generate a draft, review it, then finalize.</p>
    <button type="button" class="btn btn-primary-gradient" data-bs-toggle="modal" data-bs-target="#generateModal" data-testid="new-payroll">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> New payroll
    </button>
</div>

@if (Model.Runs.Count == 0)
{
    <section class="glass-card">
        <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true"><i class="bi bi-receipt"></i></span>
            <p class="empty-state-text">No payrolls yet. Generate the first draft to see everyone's pay for a period.</p>
            <button type="button" class="btn btn-primary-gradient" data-bs-toggle="modal" data-bs-target="#generateModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> New payroll
            </button>
        </div>
    </section>
}
else
{
    <div class="glass-table-wrap">
        <table class="glass-table">
            <caption class="visually-hidden">Payrolls, newest first</caption>
            <thead>
                <tr>
                    <th scope="col">Period</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="money">People</th>
                    <th scope="col" class="money">Net pay</th>
                    @if (admin is not null)
                    {
                        <th scope="col" class="money">Invoice</th>
                        <th scope="col" class="money">Your earning</th>
                    }
                    <th scope="col">Finalized</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Runs)
                {
                    <tr data-testid="payroll-row" data-run-id="@r.Id">
                        <td data-label="Period" class="num">
                            <a asp-action="Run" asp-route-id="@r.Id" class="cell-primary row-link">@DisplayFormat.DateRange(r.PeriodStart, r.PeriodEnd)</a>
                        </td>
                        <td data-label="Status"><span class="pill @PayrollDisplay.StatusPill(r.Status)">@PayrollDisplay.StatusLabel(r.Status)</span></td>
                        <td data-label="People" class="money num">@r.People</td>
                        <td data-label="Net pay" class="money num" data-testid="run-net-pay">@DisplayFormat.Pkr(r.TotalNetPayPkr)</td>
                        @if (admin is not null)
                        {
                            var t = admin.GetValueOrDefault(r.Id);
                            <td data-label="Invoice" class="money num">@PayrollDisplay.Usd(t?.InvoiceUsd)</td>
                            <td data-label="Your earning" class="money num">@PayrollDisplay.Usd(t?.OwnerEarningUsd)</td>
                        }
                        <td data-label="Finalized">
                            @if (r.FinalizedAt is { } at)
                            {
                                <span class="cell-stack">
                                    <span>@DisplayFormat.DateTime(at)</span>
                                    <span class="cell-sub">@(r.FinalizedBy ?? "—")</span>
                                </span>
                            }
                            else
                            {
                                <span class="text-muted-glass">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="modal fade glass-modal" id="generateModal" tabindex="-1" aria-labelledby="generateTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-action="Generate">
            <div class="modal-header">
                <h2 class="modal-title card-title" id="generateTitle">New payroll</h2>
                <button type="button" class="btn-icon btn-icon-sm" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body">
                <p>Everyone with at least one employed working day in the period gets a line. The suggested period follows the latest finalized payroll.</p>
                <div class="form-floating">
                    <input type="month" class="form-control num" id="Month" name="Month" value="@Model.Generate.Month" required />
                    <label for="Month">Month</label>
                </div>
                <fieldset class="form-section mb-0">
                    <legend class="form-section-title">Pay period</legend>
                    <div class="segmented segmented-wide">
                        <input type="radio" class="segmented-input" name="Half" id="Half-1" value="1" checked="@(Model.Generate.Half != 16)" />
                        <label class="segmented-option" for="Half-1">1st – 15th</label>
                        <input type="radio" class="segmented-input" name="Half" id="Half-16" value="16" checked="@(Model.Generate.Half == 16)" />
                        <label class="segmented-option" for="Half-16">16th – month end</label>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary-gradient" data-testid="generate-submit">Generate draft</button>
            </div>
        </form>
    </div>
</div>
