@using HR.Domain.Pay
@model ManagerPayTabViewModel
@* Manager view: pay side only. Built from ManagerPayTab, which has no billing, commission or hire-source data. *@
@{
    var tab = Model.Tab;
}

@if (!tab.HasSetup)
{
    <div class="empty-state" data-testid="pay-no-setup">
        <span class="empty-state-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
        <p class="empty-state-text">@PayRules.NoHireSourceMessage</p>
    </div>
}
else
{
    <div class="pay-toolbar">
        <a class="btn btn-primary-gradient" asp-controller="Pay" asp-action="Increment" asp-route-personId="@Model.PersonId"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Record increment</a>
    </div>

    @if (tab.Current is { } current)
    {
        <div class="pay-summary" data-testid="pay-current">
            <div class="pay-summary-item">
                <span class="pay-summary-label">Pay per month</span>
                <span class="pay-summary-value num">@DisplayFormat.Money(current.PayMonthlyAmount, current.PayCurrency)</span>
                @if (tab.UsdToPkr is { } rate)
                {
                    var other = current.PayCurrency == PayCurrency.PKR ? PayCurrency.USD : PayCurrency.PKR;
                    <span class="pay-summary-sub num">approx. @DisplayFormat.Money(PayMath.Convert(current.PayMonthlyAmount, current.PayCurrency, rate), other) at today's rate</span>
                }
            </div>
            <div class="pay-summary-item">
                <span class="pay-summary-label">Pay per full period</span>
                <span class="pay-summary-value num">@DisplayFormat.Money(current.PayPerFullPeriod, current.PayCurrency)</span>
                <span class="pay-summary-sub">Since @DisplayFormat.Date(current.EffectiveFrom)</span>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted-glass">Pay starts on @DisplayFormat.Date(tab.Rows[^1].EffectiveFrom).</p>
    }

    <div class="glass-table-wrap glass-table-wrap-inset">
        <table class="glass-table" aria-label="Pay history">
            <thead>
                <tr>
                    <th scope="col">Effective from</th>
                    <th scope="col">Change</th>
                    <th scope="col" class="money">Pay / month</th>
                    <th scope="col" class="money">Pay change</th>
                    <th scope="col">Note</th>
                    <th scope="col">Added by</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in tab.Rows)
                {
                    <tr data-testid="pay-row">
                        <td data-label="Effective from" class="num">@DisplayFormat.Date(row.EffectiveFrom)</td>
                        <td data-label="Change"><span class="pill @PayDisplay.PillClass(row.ChangeLabel)">@row.ChangeLabel</span></td>
                        <td data-label="Pay / month" class="money">@DisplayFormat.Money(row.PayMonthlyAmount, row.PayCurrency)</td>
                        <td data-label="Pay change" class="money">@(row.PayChangePercent is { } pct ? DisplayFormat.Percent(pct) : "—")</td>
                        <td data-label="Note" class="cell-wrap">@(row.Note ?? "—")</td>
                        <td data-label="Added by">@(row.AddedBy ?? "—")</td>
                        <td data-label="Actions" class="cell-actions">
                            @if (row.CreatedByMe)
                            {
                                <span class="cell-group">
                                    <a class="btn-icon" asp-controller="Pay" asp-action="EditIncrement" asp-route-personId="@Model.PersonId" asp-route-recordId="@row.Id"
                                       aria-label="Edit the pay change from @DisplayFormat.Date(row.EffectiveFrom)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <form method="post" asp-controller="Pay" asp-action="Delete" asp-route-personId="@Model.PersonId" asp-route-recordId="@row.Id" class="d-inline">
                                        <button type="submit" class="btn-icon btn-icon-danger" aria-label="Delete the pay change from @DisplayFormat.Date(row.EffectiveFrom)" title="Delete"
                                                data-confirm="The pay change from @DisplayFormat.Date(row.EffectiveFrom) will be removed."
                                                data-confirm-title="Delete this pay change?"
                                                data-confirm-action="Delete">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span class="visually-hidden">No actions</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
