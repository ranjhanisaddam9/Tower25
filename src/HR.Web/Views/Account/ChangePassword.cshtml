@using HR.Infrastructure.Identity
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Section"] = "Account";
    var forced = User.HasClaim(AppClaimTypes.MustChangePassword, "true");
}

<section class="glass-card form-card" aria-labelledby="changePasswordHeading">
    <h2 class="card-title" id="changePasswordHeading">Set a new password</h2>

    @if (forced)
    {
        <div class="glass-alert alert-warning-glass" role="status" data-testid="forced-change">
            <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
            <p class="mb-0">You're using a temporary password. Choose a new one before you continue.</p>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="glass-alert alert-danger-glass" role="alert" data-testid="change-password-errors">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <div asp-validation-summary="All" class="validation-summary-plain"></div>
        </div>
    }

    <form method="post" asp-controller="Account" asp-action="ChangePassword" novalidate>
        <div class="form-floating mb-3">
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Current password" />
            <label asp-for="CurrentPassword"></label>
        </div>

        <div class="form-floating mb-1">
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="New password" aria-describedby="passwordRules" />
            <label asp-for="NewPassword"></label>
        </div>
        <p class="form-hint" id="passwordRules">At least 10 characters, with an uppercase letter, a lowercase letter and a digit.</p>

        <div class="form-floating mb-3">
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm new password" />
            <label asp-for="ConfirmPassword"></label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary-gradient">
                <i class="bi bi-key" aria-hidden="true"></i> Change password
            </button>
            @if (!forced)
            {
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">Cancel</a>
            }
        </div>
    </form>
</section>
