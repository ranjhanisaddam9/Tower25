@using HR.Infrastructure.Identity
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var isAdmin = User.IsInRole(AppRoles.Admin);

    // Enabled sections: (label, icon, controller, action, adminOnly). The rest switch on milestone by milestone (SPEC §10).
    var enabled = new List<(string Label, string Icon, string Controller, string Action)>
    {
        ("Dashboard", "bi-grid-1x2", "Home", "Index"),
        ("People", "bi-people", "People", "Index"),
        ("Absences", "bi-calendar-x", "Absences", "Index"),
        ("Payroll", "bi-receipt", "Payroll", "Index"),
        ("Salaries", "bi-cash-stack", "Salaries", "Index"),
        ("Exchange Rates", "bi-currency-exchange", "ExchangeRates", "Index"),
        ("Reports", "bi-bar-chart-line", "Reports", "Index"),
    };
    var upcoming = new List<(string Label, string Icon)>();

    // Admin-only sections (SPEC §1: invoices and owner income are Admin-only) are not even listed for Managers.
    if (isAdmin)
    {
        enabled.Add(("Invoices", "bi-file-earmark-text", "Invoices", "Index"));
        enabled.Add(("Owner Income", "bi-graph-up-arrow", "OwnerIncome", "Index"));
        enabled.Add(("Managers", "bi-person-gear", "Managers", "Index"));
        enabled.Add(("Settings", "bi-gear", "Settings", "Index"));
    }
}
<nav class="sidebar-nav" aria-label="Sections">
    <ul class="nav-list">
        @foreach (var item in enabled)
        {
            var active = string.Equals(controller, item.Controller, StringComparison.OrdinalIgnoreCase);
            <li>
                <a class="nav-item-link @(active ? "active" : null)" asp-controller="@item.Controller" asp-action="@item.Action"
                   aria-current="@(active ? "page" : null)" title="@item.Label">
                    <i class="bi @item.Icon" aria-hidden="true"></i>
                    <span class="nav-label">@item.Label</span>
                </a>
            </li>
        }
        @foreach (var item in upcoming)
        {
            <li>
                <span class="nav-item-link disabled" aria-disabled="true" title="@item.Label (coming soon)">
                    <i class="bi @item.Icon" aria-hidden="true"></i>
                    <span class="nav-label">@item.Label</span>
                    <span class="pill pill-neutral nav-soon">Soon</span>
                    <span class="visually-hidden nav-soon-sr">(coming soon)</span>
                </span>
            </li>
        }
    </ul>
</nav>
