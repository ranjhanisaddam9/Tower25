@model StatTileViewModel
@{
    void Body()
    {
        <span class="stat-icon tone-@Model.Tone" aria-hidden="true"><i class="bi @Model.Icon"></i></span>
        <span class="stat-body">
            <span class="stat-label">@Model.Label</span>
            <span class="stat-value">@Model.Value</span>
            @if (!string.IsNullOrEmpty(Model.Caption))
            {
                <span class="stat-caption">@Model.Caption</span>
            }
            @if (!string.IsNullOrEmpty(Model.Delta))
            {
                <span class="stat-delta delta-@Model.DeltaTone">@Model.Delta</span>
            }
        </span>
    }
}
@if (Model.Href is { } href)
{
    <a class="stat-tile glass-card stat-tile-link" href="@href" data-testid="@Model.TestId">@{ Body(); }</a>
}
else
{
    <div class="stat-tile glass-card" data-testid="@Model.TestId">@{ Body(); }</div>
}
