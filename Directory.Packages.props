<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below also pin a transitive dependency (security patches). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <EfCoreVersion>10.0.12</EfCoreVersion>
    <AspNetCoreVersion>10.0.12</AspNetCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core / ASP.NET Core: same major as the pinned SDK (see global.json) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
    <!-- Security pin (transitive via Microsoft.Data.SqlClient): CVE-2026-84008 (high) and CVE-2026-70162, fixed in 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Exports (M9): .xlsx and PDF. QuestPDF runs under its Community licence (see README). -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <!-- Security (M10): authenticator QR codes and structured file logging. -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Test tooling -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
